# Copy to .env.local and fill in. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Laravel API base URL (public — called from the browser and the server)
NEXT_PUBLIC_API_URL=https://api.example.edu/api

# Extra image CDN hosts for next/image, comma-separated
IMAGE_HOSTS=

# Shared secret Laravel sends in the x-revalidate-secret header after content changes
REVALIDATE_SECRET=change-me-to-a-long-random-string
